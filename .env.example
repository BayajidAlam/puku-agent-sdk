# Puku Agent SDK Configuration

# Puku AI API Key (Required for live AI calls)
# Get your API key from https://puku.sh
PUKU_AI_API_KEY=pk_your_api_key_here

# Optional: Custom Puku Gateway / Base URL (leave empty for default)
PUKU_BASE_URL=

# Optional: Path to puku-cli executable (if not in PATH)
# Windows default: C:\Users\<Username>\AppData\Roaming\npm\puku-cli.cmd
# Linux/macOS default: /usr/local/bin/puku-cli
PUKU_CLI_PATH=
